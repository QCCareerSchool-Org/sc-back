  confidential  Boolean     @default(true)
  order         Int
  q_sections    q_sections  @relation(fields: [section_id], references: [id], map: "q_questions_ibfk_2")
  q_types       q_types     @relation(fields: [type_id], references: [id], map: "q_questions_ibfk_1")
  q_answers     q_answers[]
  q_choices     q_choices[]

  @@index([section_id], map: "section_id")
  @@index([type_id], map: "type_id")
}

model q_answers {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  result_id         Int                 @db.UnsignedInt
  question_id       Int                 @db.UnsignedInt
  choice_id         Int?                @db.UnsignedInt
  bool_answer       Boolean?
  text_answer       String?             @db.Text
  q_choices         q_choices?          @relation(fields: [choice_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "q_answers_ibfk_3")
  q_questions       q_questions         @relation(fields: [question_id], references: [id], map: "q_answers_ibfk_1")
  q_results         q_results           @relation(fields: [result_id], references: [id], onDelete: Cascade, map: "q_answers_ibfk_2")
  q_answers_choices q_answers_choices[]

  @@index([choice_id], map: "choice_id")
  @@index([question_id], map: "question_id")
  @@index([result_id], map: "result_id")
}

model q_answers_choices {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  answer_id Int       @db.UnsignedInt
  choice_id Int       @db.UnsignedInt
  q_answers q_answers @relation(fields: [answer_id], references: [id], onDelete: Cascade, map: "q_answers_choices_ibfk_3")
  q_choices q_choices @relation(fields: [choice_id], references: [id], map: "q_answers_choices_ibfk_5")

  @@index([choice_id], map: "choice_id")
  @@index([answer_id], map: "result_question_id")
}

model q_choices {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  question_id       Int                 @db.UnsignedInt
  name              String              @db.VarChar(255)
  order             Int
  q_questions       q_questions         @relation(fields: [question_id], references: [id], onDelete: Cascade, map: "q_choices_ibfk_2")
  q_answers         q_answers[]
  q_answers_choices q_answers_choices[]

  @@unique([id, question_id], map: "id")
  @@index([question_id], map: "question_id")
}

model q_results {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  form_id    Int         @db.UnsignedInt
  account_id Int
  http_post  String      @db.MediumText
  created    DateTime    @default(now()) @db.Timestamp(0)
  student    Student     @relation(fields: [account_id], references: [studentId], onDelete: Cascade, map: "q_results_ibfk_3")
  q_forms    q_forms     @relation(fields: [form_id], references: [id], map: "q_results_ibfk_1")
  q_answers  q_answers[]

  @@index([account_id], map: "account_id")
  @@index([form_id], map: "form_id")
}

model q_types {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  name        String        @db.VarChar(50)
  q_questions q_questions[]
}

model Video {
  videoId      Bytes           @id @db.Binary(16)
  src          String          @db.VarChar(2048)
  posterSrc    String?         @db.VarChar(2048)
  captionSrc   String?         @db.VarChar(2048)
  title        String          @db.VarChar(191)
  description  String?         @db.Text
  unrestricted Boolean         @default(false)
  units        VideosOnUnits[]

  @@map("videos")
}

model VideosOnUnits {
  videoId Bytes @db.Binary(16)
  unitId  Bytes @db.Binary(16)
  video   Video @relation(fields: [videoId], references: [videoId], onDelete: Cascade, map: "FK_videos_units_videos")
  unit    Unit  @relation(fields: [unitId], references: [unitId], onDelete: Cascade, map: "FK_videos_units_new_units")

  @@id([videoId, unitId])
  @@index([unitId], map: "FK_videos_units_new_units")
  @@map("videos_units")
}

model Survey {
  surveyId    Bytes  @id @db.Binary(16)
  name        String @db.VarChar(1024)
  completions SurveyCompletion[]

  @@map("surveys")
}

model SurveyCompletion {
  surveyCompletionId Bytes     @id @db.Binary(16)
  surveyId           Bytes     @db.Binary(16)
  studentId          Int
  created            DateTime  @default(now()) @db.Timestamp(0)
  modified           DateTime? @updatedAt @db.Timestamp(0)
  survey             Survey    @relation(fields: [surveyId], references: [surveyId], onDelete: Cascade, map: "FK_survey_completions_surveys")
  student            Student   @relation(fields: [studentId], references: [studentId], onDelete: Cascade, map: "FK_survey_completions_students")
  
  @@map("survey_completions")
}

model Metadata {
  metadataId  Int                     @id
  name        String                  @db.VarChar(191)
  enrollments EnrollmentsOnMetadata[]

  @@map("metadata")
}

model EnrollmentsOnMetadata {
  enrollmentId Int        @db.UnsignedInt
  metadataId   Int        
  value        String?    @db.VarChar(191)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Cascade, map: "FK_enrollments_metadata_enrollments")
  metadata     Metadata   @relation(fields: [metadataId], references: [metadataId], onDelete: Cascade, map: "FK_enrollments_metadata_metadata")

  @@map("enrollments_metadata")
  @@id(name: "id", [enrollmentId, metadataId])
}

model AwardOfExcellence {
  submissionId       Bytes                    @id @db.Binary(16)
  grade              String                   @db.VarChar(2)
  created            DateTime                 @default(now()) @db.Timestamp(0)
  newSubmission      NewSubmission            @relation(fields: [submissionId], references: [submissionId], onDelete: Restrict, map: "awards_of_excellence_ibfk_1")

  @@map("awards_of_excellence")
}

model Email {
  emailId             Bytes                         @id @db.Binary(16)
  subject             String                        @db.VarChar(255)
  htmlBody            String                        @db.MediumText
  textBody            String                        @db.MediumText
  fromName            String                        @db.VarChar(255)
  fromAddress         String                        @db.VarChar(255)
  submissionTemplates EmailsOnSubmissionTemplates[]

  @@map("email")
}

model EmailsOnSubmissionTemplates {
  submissionTemplateId Bytes                 @db.Binary(16)
  emailId              Bytes                 @db.Binary(16)
  submissionTemplate   NewSubmissionTemplate @relation(fields: [submissionTemplateId], references: [submissionTemplateId])
  email                Email                 @relation(fields: [emailId], references: [emailId])

  @@map("new_submission_templates_email")
  @@id([submissionTemplateId, emailId])
}