  assignmentNumber Int             @map("assignment")
  tutorId          Int             @map("tutor_id")
  submitted        DateTime?       @db.DateTime(0)
  marked           DateTime?       @db.DateTime(0)
  cost             Decimal?        @db.Decimal(6, 2)
  currencyId       Int?            @db.UnsignedInt @map("currency_id")
