  @@unique([enrollmentId, unitLetter], map: "student_id_unit")
  @@index([currencyId], map: "currency_id")
  @@index([enrollmentId], map: "student_id")
  @@index([tutorId], map: "tutor_id")
  @@index([unitLetter], map: "unit")
  @@map("units_submitted")
