}

model SubmittedPart {
  partId        Int                 @id @default(autoincrement()) @db.UnsignedInt @map("id")
  assignmentId  Int                 @db.UnsignedInt @map("assignment_id")
  enrollmentId  Int?                @db.UnsignedInt @map("student_id") // not used?
  partNumber    Int                 @default(1) @db.TinyInt @map("part")
  name          String              @db.VarChar(255)
  allowedTypes  String              @default(".doc,.docx") @map("allowed_types")
  optional      Boolean             @default(false)
  filename      String?             @db.VarChar(255)
  mimeTypeId    String?             @db.VarChar(255) @map("mime_type")
  compressed    Boolean             @default(false)
  creationDate  DateTime?           @db.DateTime(0) @map("creation_date")
  uploadDate    DateTime?           @db.DateTime(0) @map("upload_date")
  assignment    SubmittedAssignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade, map: "parts_submitted_ibfk_1")
  mimeType      MimeType?           @relation(fields: [mimeTypeId], references: [mimeTypeId], onDelete: Restrict, map: "parts_submitted_ibfk_2")

  @@map("parts_submitted")
  @@unique([assignmentId, partNumber], map: "assignment_id_2")
  @@index([assignmentId], map: "assignment_id")
  @@index([mimeTypeId], map: "mime_type")
}

model UnitCost {
  unitCostId     Int      @id @default(autoincrement()) @db.UnsignedInt @map("id")
  unitId         Int      @db.UnsignedInt @map("unit_id")
  countryId      Int?     @db.UnsignedInt @map("country_id")
  cost           Decimal  @db.Decimal(6, 2)
  currencyId     Int      @db.UnsignedInt @map("currency_id")
  entityVersion  Int      @default(0) @map("entity_version")
  country        Country? @relation(fields: [countryId], references: [countryId], onDelete: Restrict, map: "unit_costs_ibfk_2")
  currency       Currency @relation(fields: [currencyId], references: [currencyId], onUpdate: Restrict, map: "unit_costs_ibfk_3")
  units          Unit     @relation(fields: [unitId], references: [unitId], onDelete: Cascade, map: "unit_costs_ibfk_1")

  @@map("unit_costs")
  @@unique([unitCostId, entityVersion], map: "id_entity_version")
  @@index([countryId], map: "country_id")
  @@index([currencyId], map: "currency_id")
  @@index([unitId], map: "unit_id")
}

model Return {
  unitId        Int           @id @db.UnsignedInt @map("unit_id")
  returnedDate  DateTime?     @db.DateTime(0) @map("returned_date")
  completedDate DateTime?     @db.DateTime(0) @map("completed_date")
  unit          SubmittedUnit @relation(fields: [unitId], references: [unitId], onDelete: Cascade, onUpdate: Restrict, map: "returns_ibfk_1")

  @@map("returns")
}

model Transfer {
  transferId      Int             @id @default(autoincrement()) @db.UnsignedInt @map("id")
  unitId          Int             @db.UnsignedInt @map("unit_id")
  preTutorId      Int?            @map("pre_tutor_id")
  postTutorId     Int?            @map("post_tutor_id")
  administratorId Int?            @map("administrator_id")
  created         DateTime?       @db.DateTime(0)
  administrator   Administrator?  @relation(fields: [administratorId], references: [administratorId], map: "transfers_ibfk_4")
  preTutor        Tutor?          @relation("transfers_post_tutor_idTotutors", fields: [preTutorId], references: [tutorId], map: "transfers_ibfk_3")
  postTutor       Tutor?          @relation("transfers_pre_tutor_idTotutors", fields: [postTutorId], references: [tutorId], map: "transfers_ibfk_2")
  units           SubmittedUnit   @relation(fields: [unitId], references: [unitId], onDelete: Cascade, map: "transfers_ibfk_1")

  @@map("transfers")
  @@index([administratorId], map: "administrator_id")
  @@index([postTutorId], map: "post_tutor_id")
  @@index([preTutorId], map: "pre_tutor_id")
  @@index([unitId], map: "unit_id")
}

enum UnitResponseType {
  mp3
}






/////////////////////////////////////////////////////////////////////////
// Quiz system
/////////////////////////////////////////////////////////////////////////

model Quiz {
  quizId        Int           @id @default(autoincrement()) @db.UnsignedInt @map("id")
  unitId        Int           @db.UnsignedInt @map("unit_id")
  title         String        @db.VarChar(45)
  introduction  String?       @db.MediumText
  weight        Decimal       @db.Decimal(4, 2)
  points        Int           @default(0) @db.UnsignedMediumInt
  mark          Int?          @db.UnsignedMediumInt
  time_limit    Int?          @db.UnsignedInt
  order         Int           @db.UnsignedInt
  complete      Boolean       @default(false)
  finalized     Boolean       @default(false)
  entityVersion Int           @default(0) @map("entity_version")
  unit          SubmittedUnit @relation(fields: [unitId], references: [unitId], onDelete: Cascade, map: "quizzes_ibfk_1")
  questions     Question[]

  @@map("quizzes")
  @@unique([quizId, entityVersion], map: "id_entity_version")
  @@index([unitId], map: "unit_id")
}

model Question {
  questionId Int          @id @default(autoincrement()) @db.UnsignedInt @map("id")
  quizId     Int          @db.UnsignedInt @map("quiz_id")
  text       String       @db.MediumText
  points     Int          @db.UnsignedTinyInt
  type       QuestionType
  correct    Boolean      @default(false)
  order      Int          @db.UnsignedInt
  quiz       Quiz         @relation(fields: [quizId], references: [quizId], onDelete: Cascade, map: "quiz_id")
  answers    Answer[]

  @@map("questions")
  @@index([quizId], map: "quiz_id_idx")
}

model Answer {
  answerId   Int      @id @default(autoincrement()) @db.UnsignedInt @map("id")
  questionId Int      @db.UnsignedInt @map("question_id")
  text       String   @db.VarChar(500)
  correct    Boolean
  selected   Boolean  @default(false)
  questions  Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, map: "question_id")

  @@map("answers")
  @@index([questionId], map: "question_id_idx")
}

enum QuestionType {
  single
  multiple
  match
}






/////////////////////////////////////////////////////////////////////////
// Makeup Looks system
/////////////////////////////////////////////////////////////////////////

model LookItem {
  id           Int        @id @default(autoincrement()) @map("id")
  makeupLookId Int        @map("make_look_id")
  product      String     @db.VarChar(255)
  brand        String     @db.VarChar(255)
  shade        String     @db.VarChar(255)
  whereToBuy   String     @db.VarChar(255) @map("where_to_buy")
  makeupLook   MakeupLook @relation(fields: [makeupLookId], references: [makeupLookId], onDelete: Cascade, map: "look_items_ibfk_1")

  @@map("look_items")
  @@index([makeupLookId], map: "make_look_id")
}

model MakeupLook {
  makeupLookId Int              @id @default(autoincrement()) @map("id")
  studentId    Int              @map("account_id")
  name         String           @db.VarChar(255)
  description  String           @db.LongText
  season       MakeupLookSeason
  image_width  Int
  image_height Int
  image_type   String           @db.VarChar(255)
  look_items   LookItem[]

  @@map("makeup_looks")
}

enum MakeupLookSeason {
  spring
  summer
  fall
  winter
}

/////////////////////////////////////////////////////////////////////////
// Outfits system
/////////////////////////////////////////////////////////////////////////

model Garment {
  garmentId  Int    @id @default(autoincrement()) @map("id")
  outfitId   Int    @map("outfit_id")
  name       String @db.VarChar(255)
  brand      String @db.VarChar(255)
  details    String @db.VarChar(255)
  whereToBuy String @db.VarChar(255) @map("where_to_buy")
  outfits    Outfit @relation(fields: [outfitId], references: [outfitId], onDelete: Cascade, map: "garments_ibfk_1")

  @@map("garments")
  @@index([outfitId], map: "outfit_id")
}

model OutfitLike {
  outfitId  Int     @map("outfit_id")
  studentId Int     @map("account_id")
  outfit    Outfit  @relation(fields: [outfitId], references: [outfitId], onDelete: Cascade, map: "outfit_likes_ibfk_2")
  student   Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade, map: "outfit_likes_ibfk_1")

  @@map("outfit_likes")
  @@id([outfitId, studentId])
  @@index([studentId], map: "account_id")
}

model OutfitStyle {
  outfitStyleId Int       @id @default(autoincrement()) @map("id")
  name          String    @db.VarChar(255)
  outfits       Outfit[]

  @@map("outfit_styles")
}

model Outfit {
  outfitId      Int          @id @default(autoincrement()) @map("id")
  studentId     Int          @map("account_id")
  name          String       @db.VarChar(255)
  description   String       @db.LongText
  season        OutfitSeason
  outfitStyleId Int          @map("outfit_style_id")
  image_width   Int
  image_height  Int
  mimeTypeId    String       @db.VarChar(255) @map("image_type")
  created       DateTime     @default(now()) @db.Timestamp(0)
  student       Student      @relation(fields: [studentId], references: [studentId], onDelete: Cascade, map: "outfits_ibfk_3")
  mimeType      MimeType     @relation(fields: [mimeTypeId], references: [mimeTypeId], map: "outfits_ibfk_4")
  outfitStyles  OutfitStyle  @relation(fields: [outfitStyleId], references: [outfitStyleId], map: "outfits_ibfk_1")
  garments      Garment[]
  outfitLikes   OutfitLike[]

  @@map("outfits")
  @@index([studentId], map: "account_id")
  @@index([mimeTypeId], map: "image_type")
  @@index([outfitStyleId], map: "outfit_style_id")
}

enum OutfitSeason {
  spring
  summer
  fall
  winter
}

/////////////////////////////////////////////////////////////////////////
// Questionnaire system
/////////////////////////////////////////////////////////////////////////

model q_forms {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  name          String       @db.VarChar(50)
  title         String       @db.VarChar(50)
  introduction  String?      @db.Text
  studentTypeId String       @db.VarChar(50) @map("student_type")
  result_count  Int          @default(0) @db.UnsignedInt
  enabled       Boolean      @default(false)
  ended         Boolean      @default(false)
  created       DateTime     @default(now()) @db.Timestamp(0)
  studentType   StudentType  @relation(fields: [studentTypeId], references: [studentTypeId], map: "q_forms_ibfk_1")
  q_results     q_results[]
  q_sections    q_sections[]

  @@index([studentTypeId], map: "student_type")
}

model q_sections {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  form_id     Int           @db.UnsignedInt
  name        String        @db.VarChar(255)
  order       Int
  q_forms     q_forms       @relation(fields: [form_id], references: [id], onDelete: Cascade, map: "q_sections_ibfk_2")
  q_questions q_questions[]

  @@index([form_id], map: "form_id")
}

model q_questions {
  id            Int         @id @default(autoincrement()) @db.UnsignedInt
  section_id    Int         @db.UnsignedInt
  name          String      @db.VarChar(255)
  type_id       Int         @db.UnsignedInt
  other_allowed Boolean     @default(false)
  optional      Boolean     @default(false)
  confidential  Boolean     @default(true)
  order         Int
  q_sections    q_sections  @relation(fields: [section_id], references: [id], map: "q_questions_ibfk_2")
  q_types       q_types     @relation(fields: [type_id], references: [id], map: "q_questions_ibfk_1")
  q_answers     q_answers[]
  q_choices     q_choices[]

  @@index([section_id], map: "section_id")
  @@index([type_id], map: "type_id")
}

model q_answers {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  result_id         Int                 @db.UnsignedInt
  question_id       Int                 @db.UnsignedInt
  choice_id         Int?                @db.UnsignedInt
  bool_answer       Boolean?
  text_answer       String?             @db.Text
  q_choices         q_choices?          @relation(fields: [choice_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "q_answers_ibfk_3")
  q_questions       q_questions         @relation(fields: [question_id], references: [id], map: "q_answers_ibfk_1")
  q_results         q_results           @relation(fields: [result_id], references: [id], onDelete: Cascade, map: "q_answers_ibfk_2")
  q_answers_choices q_answers_choices[]

  @@index([choice_id], map: "choice_id")
  @@index([question_id], map: "question_id")
  @@index([result_id], map: "result_id")
}

model q_answers_choices {
  id        Int       @id @default(autoincrement()) @db.UnsignedInt
  answer_id Int       @db.UnsignedInt
  choice_id Int       @db.UnsignedInt
  q_answers q_answers @relation(fields: [answer_id], references: [id], onDelete: Cascade, map: "q_answers_choices_ibfk_3")
  q_choices q_choices @relation(fields: [choice_id], references: [id], map: "q_answers_choices_ibfk_5")

  @@index([choice_id], map: "choice_id")
  @@index([answer_id], map: "result_question_id")
}

model q_choices {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  question_id       Int                 @db.UnsignedInt
  name              String              @db.VarChar(255)
  order             Int
  q_questions       q_questions         @relation(fields: [question_id], references: [id], onDelete: Cascade, map: "q_choices_ibfk_2")
  q_answers         q_answers[]
  q_answers_choices q_answers_choices[]

  @@unique([id, question_id], map: "id")
  @@index([question_id], map: "question_id")
}

model q_results {
  id         Int         @id @default(autoincrement()) @db.UnsignedInt
  form_id    Int         @db.UnsignedInt
  account_id Int
  http_post  String      @db.MediumText
  created    DateTime    @default(now()) @db.Timestamp(0)
  student    Student     @relation(fields: [account_id], references: [studentId], onDelete: Cascade, map: "q_results_ibfk_3")
  q_forms    q_forms     @relation(fields: [form_id], references: [id], map: "q_results_ibfk_1")
  q_answers  q_answers[]

  @@index([account_id], map: "account_id")
  @@index([form_id], map: "form_id")
}

model q_types {
  id          Int           @id @default(autoincrement()) @db.UnsignedInt
  name        String        @db.VarChar(50)
  q_questions q_questions[]
}






