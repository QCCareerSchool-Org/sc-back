// Course Materials system v5
/////////////////////////////////////////////////////////////////////////

model Unit {
  unitId     Bytes           @id @map("unit_id") @db.Binary(16)
  courseId   Int             @map("course_id") @db.UnsignedInt
  unitLetter String          @map("unit_letter") @db.Char(1)
  title      String?         @db.VarChar(255)
  order      Int             @default(0) @db.UnsignedInt
  created    DateTime        @default(now()) @db.Timestamp(0)
  modified   DateTime?       @updatedAt @db.Timestamp(0)
  course     Course          @relation(fields: [courseId], references: [courseId], map: "FK_new_units_courses")
  materials  Material[]
  videos     VideosOnUnits[]

  @@unique([courseId, unitLetter], map: "course_id_unit_letter")
  @@index([courseId, order, unitLetter], map: "course_id_order_unit_letter")
  @@map("new_units")
}

model Material {
  materialId          Bytes                @id @map("material_id") @db.Binary(16)
  unitId              Bytes                @map("unit_id") @db.Binary(16)
  type                NewMaterialType
  title               String               @db.VarChar(255)
  description         String               @db.Text
  order               Int                  @default(0)
  filename            String?              @db.VarChar(255)
  contentMimeTypeId   String?              @map("content_mime_type_id") @db.VarChar(255)
  imageMimeTypeId     String?              @map("image_mime_type_id") @db.VarChar(255)
  externalData        String?              @map("external_data") @db.VarChar(1024)
  entryPoint          String?              @map("entry_point") @db.VarChar(255)
  minutes             Int?
  chapters            Int?
  videos              Int?
  knowledgeChecks     Int?                 @map("knowledge_checks")
  created             DateTime             @default(now()) @db.Timestamp(0)
  modified            DateTime?            @updatedAt @db.Timestamp(0)
  contentMimeType     MimeType?            @relation("mime_typesTonew_materials_content_mime_type", fields: [contentMimeTypeId], references: [mimeTypeId], onDelete: Restrict, map: "FK_new_materials_content_mime_types")
  imageMimeType       MimeType?            @relation("mime_typesTonew_materials_image_mime_type", fields: [imageMimeTypeId], references: [mimeTypeId], onDelete: Restrict, map: "FK_new_materials_image_mime_types")
  unit                Unit                 @relation(fields: [unitId], references: [unitId], map: "FK_new_materials_new_units")
  materialCompletions MaterialCompletion[] @relation("new_material_completionsTonew_materials")
  materialData        MaterialData[]       @relation()

  @@index([unitId, order], map: "unit_id_order")
  @@index([contentMimeTypeId], map: "content_mime_type_id")
  @@index([imageMimeTypeId], map: "image_mime_type_id")
  @@map("new_materials")
}

model MaterialCompletion {
  materialId   Bytes      @map("material_id") @db.Binary(16)
  enrollmentId Int        @map("enrollment_id") @db.UnsignedInt
  material     Material   @relation("new_material_completionsTonew_materials", fields: [materialId], references: [materialId], onDelete: Cascade, map: "FK_new_material_completions_new_materials")
  enrollment   Enrollment @relation("new_material_completionsTostudents", fields: [enrollmentId], references: [enrollmentId], onDelete: Cascade, map: "FK_new_material_completions_students")

  @@id([materialId, enrollmentId])
  @@index([enrollmentId], map: "enrollment_id")
  @@map("new_material_completions")
}

model MaterialData {
  materialId   Bytes      @db.Binary(16)
  enrollmentId Int        @db.UnsignedInt
  key          String     @db.VarChar(512)
  value        String     @db.Text
  material     Material   @relation(fields: [materialId], references: [materialId], onDelete: Cascade, map: "FK_new_material_data_new_materials")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [enrollmentId], onDelete: Cascade, map: "FK_new_material_data_students")

  @@id([materialId, enrollmentId, key])
  @@map("new_material_data")
}

enum NewMaterialType {
  lesson
  video
  download
  assignment
  scorm2004 @map("SCORM 2004 package")
}


