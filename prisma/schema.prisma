  transferredDate  DateTime?             @db.DateTime(0) @map("transferred_date")
  tutorId          Int?                  @map("tutor_id")
  audioReply       Bytes?                @map("audio_reply")
  markedDate       DateTime?             @db.DateTime(0) @map("marked_date")
