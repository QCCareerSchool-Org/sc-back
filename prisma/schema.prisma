  @@index([code], map: "code")
}

model Province {
  provinceId             Int               @id @default(autoincrement()) @db.UnsignedInt @map("id")
  countryId              Int               @db.UnsignedInt @map("country_id")
  regionId               Int?              @db.UnsignedInt @map("region_id")
  // countryCode            String            @default("") @db.Char(2) @map("country_code") // TODO: remove column
  code                   String            @default("") @db.Char(3)
  name                   String            @default("") @db.VarChar(50)
  regionCode             String?           @db.VarChar(3) @map("region_code")
  alternateAbbreviation  String?           @db.Char(3) @map("alternate_abbreviation")
  type                   String?           @db.VarChar(60)
