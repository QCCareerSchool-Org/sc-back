  @@map("material")
  @@unique([materialId, entityVersion], map: "id_entity_version")
  @@index([categoryId], map: "category_id")
  @@index([contentMimeTypeId], map: "content_mime")
  @@index([imagemimeTypeId], map: "image_mime")
}

model Category {
  categoryId    Int        @id @default(autoincrement()) @db.UnsignedInt @map("id")
  name          String     @db.VarChar(255)
  order         Int        @default(0) @db.UnsignedInt
  entityVersion Int        @default(0) @map("entity_version")
