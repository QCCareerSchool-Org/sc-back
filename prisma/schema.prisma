  order           Int      @default(0) @db.UnsignedInt
  entityVersion   Int      @default(0) @map("entity_version")
  course          Course   @relation(fields: [courseId], references: [courseId], map: "material_rights_ibfk_2")
  material        Material @relation(fields: [materialId], references: [materialId], map: "material_rights_ibfk_1")

