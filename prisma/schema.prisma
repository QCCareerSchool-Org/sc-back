  @@map("categories")
  @@unique([categoryId, entityVersion], map: "id_entity_version")
}

model MaterialRight {
  materialRightId Int      @id @default(autoincrement()) @db.UnsignedInt @map("id")
  materialId      Int      @db.UnsignedInt @map("material_id")
  courseId        Int      @db.UnsignedInt @map("course_id")
  unit            String?  @db.Char(1)
