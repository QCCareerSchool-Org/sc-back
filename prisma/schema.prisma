model FinalSubmission {
  enrollmentId Int        @id @db.UnsignedInt @map("student_id")
  created      DateTime   @default(now()) @db.Timestamp(0)
  cleared      Boolean    @default(false)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "final_submissions_ibfk_1")

  @@map("final_submissions")
}

model flags {
  account_id Int
  key        String   @db.VarChar(192)
  value      Boolean?
  student    Student  @relation(fields: [account_id], references: [studentId], onDelete: Cascade, onUpdate: Restrict, map: "flags_ibfk_1")

  @@id([account_id, key])
  @@index([account_id], map: "account_id")
}

