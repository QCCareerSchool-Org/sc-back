  t2202Receipts          T2202Receipt[]

  @@map("provinces")
  @@unique([countryId, code], map: "country_id_code")
  @@unique([regionId, code], map: "region_id_code")
  @@unique([provinceId, entityVersion], map: "id_entity_version")
  @@index([code], map: "code")
}






