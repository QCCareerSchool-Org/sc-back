model help {
  topic         String            @id @db.VarChar(100)
  title         String            @db.VarChar(100)
  restriction   help_restriction?
  description   String            @db.Text
  filename      String            @db.VarChar(100)
  order         Int               @default(0) @db.UnsignedInt
  help_keywords help_keywords[]

  @@index([title], map: "title")
}

model help_keywords {
  id         Int    @id
  help_topic String @db.VarChar(100)
  keyword    String @db.VarChar(100)
  help       help   @relation(fields: [help_topic], references: [topic], onDelete: Cascade, map: "help_keywords_ibfk_2")

  @@index([help_topic], map: "help_topic")
}

