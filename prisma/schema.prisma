model Quiz {
  quizId        Int           @id @default(autoincrement()) @map("id") @db.UnsignedInt
  submissionId  Int           @map("unit_id") @db.UnsignedInt
  title         String        @db.VarChar(45)
  introduction  String?       @db.MediumText
  weight        Decimal       @db.Decimal(4, 2)
  points        Int           @default(0) @db.UnsignedMediumInt
  mark          Int?          @db.UnsignedMediumInt
  time_limit    Int?          @db.UnsignedInt
  order         Int           @db.UnsignedInt
  complete      Boolean       @default(false)
  finalized     Boolean       @default(false)
  entityVersion Int           @default(0) @map("entity_version")
  oldSubmission OldSubmission @relation(fields: [submissionId], references: [submissionId], onDelete: Cascade, map: "quizzes_ibfk_1")
  questions     Question[]

  @@unique([quizId, entityVersion], map: "id_entity_version")
  @@index([submissionId], map: "unit_id")
  @@map("quizzes")
}

model Question {
  questionId Int          @id @default(autoincrement()) @map("id") @db.UnsignedInt
  quizId     Int          @map("quiz_id") @db.UnsignedInt
  text       String       @db.MediumText
  points     Int          @db.UnsignedTinyInt
  type       QuestionType
  correct    Boolean      @default(false)
  order      Int          @db.UnsignedInt
  quiz       Quiz         @relation(fields: [quizId], references: [quizId], onDelete: Cascade, map: "quiz_id")
  answers    Answer[]

  @@index([quizId], map: "quiz_id_idx")
  @@map("questions")
}

model Answer {
  answerId   Int      @id @default(autoincrement()) @map("id") @db.UnsignedInt
  questionId Int      @map("question_id") @db.UnsignedInt
  text       String   @db.VarChar(500)
  correct    Boolean
  selected   Boolean  @default(false)
  questions  Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, map: "question_id")

  @@index([questionId], map: "question_id_idx")
  @@map("answers")
}

enum QuestionType {
  single
  multiple
  match
}






