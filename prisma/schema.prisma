  @@index([courseId], map: "course_id")
  @@index([materialId], map: "material_id")
}

model Subtitle {
  materialId      Int      @id @db.UnsignedInt @map("material_id")
  externalContent String?  @map("external_content")
  material        Material @relation(fields: [materialId], references: [materialId], onUpdate: Restrict, map: "FK__material")

