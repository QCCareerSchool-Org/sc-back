  finalizedDate    DateTime?         @map("finalized_date") @db.Timestamp(0)
  transferredDate  DateTime?         @map("transferred_date") @db.Timestamp(0)
  tutorId          Int?              @map("tutor_id")
  audioReply       Bytes?            @map("audio_reply")
  markedDate       DateTime?         @map("marked_date") @db.Timestamp(0)
  tutorComment     String?           @map("tutor_comment") @db.Text
  adminComment     String?           @map("admin_comment") @db.Text
  optional         Boolean           @default(false)
  noMarks          Boolean           @default(false) @map("no_marks")
  noAssignments    Boolean           @default(false) @map("no_assignments")
  optionalUpload   Boolean           @default(false) @map("optional_upload")
  order            Int               @default(0) @db.UnsignedInt
  skipped          Boolean           @default(false)
  cost             Decimal?          @db.Decimal(6, 2)
  currencyId       Int?              @map("currency_id") @db.UnsignedInt
