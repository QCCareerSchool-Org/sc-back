model look_items {
  id           Int          @id @default(autoincrement())
  make_look_id Int
  product      String       @db.VarChar(255)
  brand        String       @db.VarChar(255)
  shade        String       @db.VarChar(255)
  where_to_buy String       @db.VarChar(255)
  makeup_looks makeup_looks @relation(fields: [make_look_id], references: [id], onDelete: Cascade, map: "look_items_ibfk_1")

  @@index([make_look_id], map: "make_look_id")
}

model makeup_looks {
  id           Int                 @id @default(autoincrement())
  account_id   Int
  name         String              @db.VarChar(255)
  description  String              @db.LongText
  season       makeup_looks_season
  image_width  Int
  image_height Int
  image_type   String              @db.VarChar(255)
  look_items   look_items[]
}

model material {
  id                  Int               @id @default(autoincrement()) @db.UnsignedInt
  categoryId          Int               @db.UnsignedInt @map("category_id")
  title               String            @db.VarChar(255)
  contentFilename     String            @db.VarChar(255) @map("content_filename")
  contentMimeTypeType String            @db.VarChar(255) @map("content_mime")
  imageMimeTypeType   String?           @db.VarChar(255) @map("image_mime")
  externalContent     String?           @db.VarChar(255) @map("external_content")
  externalImage       String?           @db.VarChar(255) @map("external_image")
  entityVersion       Int               @default(0) @map("entity_version")
  categories          categories        @relation(fields: [categoryId], references: [id], map: "material_ibfk_2")
  contentMimeType     MimeType          @relation("material_content_mimeTomime_types", fields: [contentMimeTypeType], references: [type], map: "material_ibfk_3")
  imageMimeType       MimeType?         @relation("material_image_mimeTomime_types", fields: [imageMimeTypeType], references: [type], onDelete: Restrict, map: "material_ibfk_4")
  materialRights      material_rights[]
  subtitle            subtitles?

  @@unique([id, entityVersion], map: "id_entity_version")
  @@index([categoryId], map: "category_id")
  @@index([contentMimeTypeType], map: "content_mime")
  @@index([imageMimeTypeType], map: "image_mime")
}

model material_rights {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  materialId    Int      @db.UnsignedInt @map("material_id")
  courseId      Int      @db.UnsignedInt @map("course_id")
  unit          String?  @db.Char(1)
  forms         Boolean? @default(false)
  order         Int      @default(0) @db.UnsignedInt
  entityVersion Int      @default(0) @map("entity_version")
  course        Course   @relation(fields: [courseId], references: [id], map: "material_rights_ibfk_2")
  material      material @relation(fields: [materialId], references: [id], map: "material_rights_ibfk_1")

  @@unique([id, entityVersion], map: "id_entity_version")
  @@index([courseId], map: "course_id")
  @@index([materialId], map: "material_id")
}

model materials {
  id           Int      @id @default(autoincrement())
  pathId       Int      @map("path_id")
  filename     String   @db.VarChar(100)
  mimeTypeType String   @default("application/pdf") @db.VarChar(255) @map("mime_type")
  mimeType     MimeType @relation(fields: [mimeTypeType], references: [type], map: "materials_ibfk_2")
  path         paths    @relation(fields: [pathId], references: [id], map: "materials_ibfk_1")

  @@unique([pathId, filename], map: "fullpath")
  @@index([mimeTypeType], map: "mime_type")
}

model Message {
  messageId       BigInt         @id @default(autoincrement()) @db.UnsignedBigInt @map("id")
  threadId        BigInt         @db.UnsignedBigInt @map("thread_id")
  tutorId         Int?           @map("tutor_id")
  administratorId Int?           @map("administrator_id")
  body            String?        @db.MediumText
  sentDate        DateTime       @db.DateTime(0) @map("sent_date")
  readDate        DateTime?      @db.DateTime(0) @map("read_date")
  reply           Boolean        @default(false)
  administrator   Administrator? @relation(fields: [administratorId], references: [administratorId], onDelete: Restrict, map: "messages_ibfk_3")
  thread          Thread         @relation(fields: [threadId], references: [threadId], onDelete: Cascade, map: "messages_ibfk_1")
  tutor           Tutor?         @relation(fields: [tutorId], references: [tutorId], onDelete: Restrict, map: "messages_ibfk_2")

  @@map("messages")
  @@index([administratorId], map: "administrator_id")
  @@index([threadId], map: "thread_id")
  @@index([tutorId], map: "tutor_id")
}

model MimeType {
  type                                                         String                                   @id @db.VarChar(255)
  compress                                                     Boolean                                  @default(false)
  entity_version                                               Int                                      @default(0)
  course_material                                              course_material[]
  feeds                                                        feeds[]
  // files                                                        files[]
  // images                                                       images[]
  material_material_content_mimeTomime_types                   material[]                               @relation("material_content_mimeTomime_types")
  material_material_image_mimeTomime_types                     material[]                               @relation("material_image_mimeTomime_types")
  materials                                                    materials[]
  new_assignment_media_element_templates                       NewAssignmentMediaElementTemplate[]
  new_assignment_media_elements                                NewAssignmentMediaElement[]
  new_part_media_element_templates                             NewPartMediaElementTemplate[]
  new_part_media_elements                                      NewPartMediaElement[]
  // outfits                                                      outfits[]
  parts_submitted                                              parts_submitted[]
  pictures                                                     pictures[]
  portraits                                                    portraits[]
  uploads                                                      uploads[]
  writing_files_mime_typesTowriting_files_correction_mime_type writing_files[]                          @relation("mime_typesTowriting_files_correction_mime_type")
  writing_files_mime_typesTowriting_files_mime_type            writing_files[]                          @relation("mime_typesTowriting_files_mime_type")
  writing_profiles                                             writing_profiles[]

  @@map("mime_types")
  @@unique([type, entity_version], map: "type_entity_version")
}

model modules {
  module_id   Bytes   @id @db.Binary(16)
  course_id   Int     @db.UnsignedInt
  unit        String? @db.Char(1)
  order       Int?
  heading     String
  description String  @db.Text
}

